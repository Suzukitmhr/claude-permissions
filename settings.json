{
  "version": "1.2.2",
  "model": "sonnet",
  "alwaysThinkingEnabled": false,
  "autoUpdatesChannel": "latest",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/check-version.js\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/block-sensitive-files.js\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/block-sensitive-bash.js\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/notify.js\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/notify.js\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read(**)",
      "Edit(**)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(cd:*)",
      "Bash(cat:*)",
      "Bash(sed:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(tree:*)",
      "Bash(stat:*)",
      "Bash(file:*)",
      "Bash(diff:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(date)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git blame:*)",
      "Bash(git describe:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git shortlog:*)",
      "Bash(git config --get:*)",
      "Bash(git config --list:*)",
      "Bash(git remote -v:*)"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch --delete:*)",
      "Bash(sed -i:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/hooks/**)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(id_rsa)",
      "Read(**/id_rsa)",
      "Read(id_ed25519)",
      "Read(**/id_ed25519)",
      "Read(id_ecdsa)",
      "Read(**/id_ecdsa)",
      "Read(.npmrc)",
      "Read(**/.npmrc)",
      "Read(.netrc)",
      "Read(**/.netrc)",
      "Read(.git-credentials)",
      "Read(**/.git-credentials)",
      "Read(**/.kube/config)",
      "Read(**.tfvars)",
      "Read(appsettings.json)",
      "Read(appsettings.*.json)",
      "Read(**/appsettings.json)",
      "Read(**/appsettings.*.json)",
      "Read(ssc-connections.json)",
      "Read(ssc-connections.*.json)",
      "Read(**/ssc-connections.json)",
      "Read(**/ssc-connections.*.json)",
      "Read(**/.aws/credentials)",
      "Read(**/.aws/config)",
      "Read(**.pem)",
      "Read(**.key)",
      "Read(**.pfx)",
      "Read(**.p12)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(id_rsa)",
      "Edit(**/id_rsa)",
      "Edit(id_ed25519)",
      "Edit(**/id_ed25519)",
      "Edit(id_ecdsa)",
      "Edit(**/id_ecdsa)",
      "Edit(.npmrc)",
      "Edit(**/.npmrc)",
      "Edit(.netrc)",
      "Edit(**/.netrc)",
      "Edit(.git-credentials)",
      "Edit(**/.git-credentials)",
      "Edit(**/.kube/config)",
      "Edit(**.tfvars)",
      "Edit(appsettings.json)",
      "Edit(appsettings.*.json)",
      "Edit(**/appsettings.json)",
      "Edit(**/appsettings.*.json)",
      "Edit(ssc-connections.json)",
      "Edit(ssc-connections.*.json)",
      "Edit(**/ssc-connections.json)",
      "Edit(**/ssc-connections.*.json)",
      "Edit(**/.aws/credentials)",
      "Edit(**/.aws/config)",
      "Edit(**.pem)",
      "Edit(**.key)",
      "Edit(**.pfx)",
      "Edit(**.p12)"
    ]
  }
}
